# Every value below is optional unless noted. Field names on Settings map to
# these upper-case keys (src/ai_job_tracker/config.py). Leaving a key blank is
# treated as unset, so the documented default applies.

# --- Telegram (required before any notification is sent) ---
# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
# Telegram chat or channel that should receive notifications.
# No repository-owned fallback exists; set it here or pass --chat-id.
TELEGRAM_CHAT_ID=

# --- Analysis backend ---
# "api" (default) or "browser". Install the matching extra:
#   pip install 'ai-job-tracker[api]'      # pydantic-ai
#   pip install 'ai-job-tracker[browser]'   # Playwright
ANALYSIS_BACKEND=

# --- API backend (ANALYSIS_BACKEND=api) ---
# API key for the configured model. For Gemini: https://aistudio.google.com/api-keys
AI_API_KEY=
# pydantic-ai model string. Default: google:gemini-2.5-flash
# Examples: google:gemini-2.5-flash, openai:gpt-4o, anthropic:claude-sonnet-4-20250514
AI_MODEL=

# --- Browser backend (ANALYSIS_BACKEND=browser) ---
# After installing the extra, run: playwright install chromium
# Brave/Chrome profile directory holding an authenticated Gemini session.
BROWSER_PROFILE_PATH=
# Browser executable path or command for Gemini. Blank lets Playwright fall
# back to common browsers on PATH, then its bundled Chromium (recommended).
GEMINI_BROWSER_EXECUTABLE=
# Gemini web app URL. Default: https://gemini.google.com/app
GEMINI_URL=

# --- File paths (relative to the directory the CLI runs in) ---
# Your CV as plain text. Default: profile.txt
PROFILE_FILE=
# Jobs input consumed by job-analyze. Default: jobs.jsonl
JOBS_INPUT_FILE=
# Analysis output. Default: analysis_results.jsonl
ANALYSIS_OUTPUT_FILE=
